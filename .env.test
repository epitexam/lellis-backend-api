# --- DATABASE CONFIGURATION (TEST) ---
# We use a dedicated test database to avoid side effects on development data
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db_test
DB_CONNECTION_LIMIT=5

# --- SECURITY & JWT (TEST) ---
# Shorter expiry for testing token refresh logic
SECRET=test_secret_key_fixed_for_reproducible_tests_12345
DAYS=1
ACCESS_TOKEN_EXPIRY=300

# --- APP CONFIGURATION ---
NODE_ENV=test
PORT=3001
LOG_LEVEL=silent
DAYS=7